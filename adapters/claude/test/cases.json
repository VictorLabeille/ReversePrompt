[
 {
  "name": "Stop depuis le CLI",
  "env": {
   "CLAUDE_CODE_ENTRYPOINT": "cli"
  },
  "hook": {
   "hook_event_name": "Stop",
   "session_id": "s1",
   "last_assistant_message": "fini"
  },
  "expect": {
   "v": 1,
   "kind": "done",
   "session": "s1",
   "source": "claude-code",
   "focus": {
    "process": "WindowsTerminal.exe"
   }
  }
 },
 {
  "name": "Stop avec tâches de fond : pas fini",
  "env": {
   "CLAUDE_CODE_ENTRYPOINT": "cli"
  },
  "hook": {
   "hook_event_name": "Stop",
   "session_id": "s1",
   "background_tasks": [
    {
     "id": "t"
    }
   ]
  },
  "expect": null
 },
 {
